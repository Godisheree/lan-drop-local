{
  "name": "lan-drop-local",
  "version": "1.1.1",
  "description": "LAN file sharing via browser — no cloud, no setup",
  "main": "main.js",
  "bin": {
    "lan-drop": "tui.js"
  },
  "files": [
    "tui.js",
    "main.js",
    "preload.js",
    "server/",
    "public/"
  ],
  "scripts": {
    "start": "node tui.js",
    "server": "node server/index.js",
    "start:debug": "node server/index.js --debug",
    "electron-dev": "electron .",
    "build-win": "electron-builder --win",
    "check": "node scripts/check-js.js",
    "audit": "node scripts/audit-charset.js",
    "check:unused": "node scripts/check-unused-imports.js",
    "check:security": "node scripts/check-security.js",
    "check:identity": "node scripts/check-identity.js",
    "check:routing": "node scripts/check-routing.js",
    "check:routes": "node scripts/check-routes.js",
    "check:transcode": "node scripts/check-transcode.js",
    "check:autoapprove": "node scripts/check-autoapprove.js",
    "check:ack": "node scripts/check-ack.js",
    "smoke": "node scripts/smoke.js --url http://localhost:3000",
    "verify:qr": "node scripts/verify-qr.js --url http://localhost:3000",
    "verify:pwa": "node scripts/verify-pwa.js --url http://localhost:3000",
    "icons": "node scripts/generate-icons.js",
    "e2e": "node scripts/e2e.js",
    "test": "node scripts/check-js.js && node scripts/audit-charset.js && node scripts/check-unused-imports.js && node scripts/check-security.js && node scripts/check-identity.js && node scripts/check-routing.js && node scripts/check-autoapprove.js && node scripts/check-ack.js && node scripts/check-settings.js && node scripts/check-dashboard.js && node scripts/check-tui.js",
    "check:tui": "node scripts/check-tui.js",
    "check:settings": "node scripts/check-settings.js",
    "check:dashboard": "node scripts/check-dashboard.js"
  },
  "keywords": [
    "lan",
    "file-transfer",
    "share-files",
    "local-network",
    "airdrop",
    "termux",
    "cli"
  ],
  "author": "Godisheree",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Godisheree/lan-drop-local.git"
  },
  "homepage": "https://github.com/Godisheree/lan-drop-local#readme",
  "bugs": {
    "url": "https://github.com/Godisheree/lan-drop-local/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@electron-internal/extract-zip": "^1.0.4",
    "express": "^5.2.1",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.landrop.app",
    "productName": "LAN Drop",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "server/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    }
  }
}
